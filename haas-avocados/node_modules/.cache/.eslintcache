fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"81","messages":"82","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"83","messages":"84","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"85","usedDeprecatedRules":"52"},{"filePath":"86","messages":"87","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"88","messages":"89","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"90","usedDeprecatedRules":"52"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"52"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"100","messages":"101","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"102","usedDeprecatedRules":"52"},{"filePath":"103","messages":"104","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"105","messages":"106","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"107","messages":"108","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/index.js",[],["109","110"],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/App.js",["111","112","113"],"import React, { useEffect } from \"react\";\nimport { BrowserRouter as Router, Link, Switch, Route, Redirect } from \"react-router-dom\";\nimport Navbar from \"./components/navbar\";\nimport Landing from \"./pages/Landing\";\nimport Login from \"./pages/Login\";\nimport LoggedOut from \"./pages/LoggedOut\";\nimport Project from \"./pages/Projects\";\nimport Project2 from \"./pages/Projectv2\"\nimport Dataset from \"./pages/Datasets\";\nimport Dashboard from \"./pages/Dashboard\";\nimport Button from \"@mui/material/Button\";\nimport \"./App.css\";\nimport AddProject from \"./pages/AddProject\";\nimport { createTheme, ThemeProvider } from \"@mui/material/styles\";\nimport { Paper } from \"@mui/material\";\n\nimport Auth from \"./Auth\";\n\nfunction App() {\n\n  useEffect(() => {\n    document.title = \"Haas Avocados\";\n  }, []);\n  \n  const theme = createTheme({\n    palette: {\n      mode: \"dark\",\n      primary: {\n        main: \"#2eb62c\",\n      },\n      secondary: {\n        main: \"#ffeca1\",\n      },\n      },\n      components: {\n        MuiTextField: {\n          styleOverrides: {\n            root: {\n            },\n          },\n          defaultProps: {\n            variant: \"outlined\",\n            focused: true,\n\n          },\n        },\n        MuiOutlinedInput: {\n          styleOverrides: {\n            root: {\n            },\n          },\n        },\n        MuiInputLabel: {\n            styleOverrides: {\n              root: {\n              },\n            },\n          },\n    },\n  });\n\n  \n\n  function requireAuth(component) {\n    return !Auth.isAuthenticated() ? <Redirect to=\"/login\" /> : component;\n  }\n\n  return (\n    <ThemeProvider theme={theme}>\n      <Paper style={{ height: \"100vh\" }}>\n        <div className=\"App\">\n          <Router>\n            <Navbar isAuth={Auth.isAuthenticated()} />\n            <Switch>\n              <Route path=\"/\" exact component={Landing} />\n              <Route path=\"/dashboard\" exact render={() => requireAuth(<Dashboard />)} />\n              <Route path=\"/logout\" exact render={() => requireAuth(<LoggedOut auth={Auth} />)} /> \n              <Route path=\"/login\" exact component={Login} />\n              <Route path=\"/projects\" exact render={() => requireAuth(<Project />)} />\n              <Route path=\"/addproject\" exact render={() => requireAuth(<AddProject />)} />\n              <Route path=\"/datasets\" exact component={Dataset} />\n            </Switch>\n\n            {/* Buttons to test login/logout functionality */}\n            <button onClick={() => Auth.login(\"test\",\"test\").then(data => console.log(data))}>Login</button>\n            <button onClick={() => console.log(Auth.getCurrentToken())}>Get User</button>\n            <button onClick={() => Auth.get('/protected').then(data => console.log(data))}>test</button>\n            <button onClick={() => Auth.logout()}>logout</button>\n          </Router>\n        </div>\n      </Paper>\n    </ThemeProvider>\n  );\n}\n\nexport default App;\n","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/reportWebVitals.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/Auth.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Login.js",["114","115","116","117","118"],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Landing.js",["119","120","121"],"/**\n * Landing.js\n * The landing page for the website\n */\n\nimport React from \"react\";\nimport {BrowserRouter as Router, Switch, Route} from 'react-router-dom';\n\nclass Landing extends React.Component {\n  render() {\n    return (\n        <>\n          <div >\n            <h1>Welcome to Haas: Avacado</h1>\n            <iframe width=\"560\" \n            height=\"315\" \n            src=\"https://www.youtube.com/embed/aGMKAhCRQ8Y\" \n            title=\"YouTube video player\" \n            frameborder=\"0\" \n            allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n             allowfullscreen>\n             </iframe>\n          </div>\n          <div>\n            <h4>About Us</h4>\n            <p>\n              We are a Hardware as a Service(Haas) company with the mission of providing optimal hardware for research in various fields. \n              Our team maintains the hardware and ensures quality equipment. You rent our equipment to use for your projects. Our site maintains \n              your projects, data, and profile all in one place. With Haas:Avacado you can guac that project up.\n            </p>\n          </div>\n          <div>\n            <h4>Meet the Team</h4>\n            <p>\n              Get images and bios for everyone\n            </p>\n          </div>\n        </>\n    )\n  }\n}\n\nexport default Landing;\n","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/LoggedOut.js",["122"],"import React from \"react\";\nimport { Link } from \"react-router-dom\";\nimport Auth from \"../Auth\";\n\nclass LoggedOut extends React.Component{\n\n  componentDidMount() {\n    this.props.auth.logout();\n  }\n\n  render() {\n    return (\n      <>\n        <h1>You have been logged out</h1>\n        <Link to='/login'>Click here to log back in</Link>\n      </>\n    )\n  }\n}\n\nexport default LoggedOut;","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Projects.js",["123","124"],"/**\n * Project.js\n * Temp for landing page\n */\n\nimport React, { useRef } from \"react\";\nimport '../styles/project.css'\nimport Table from '../components/table'\nimport {Button} from '../components/button.style';\nimport { useHistory } from 'react-router-dom';\n \nfunction Project (){\n  const tableInstance = useRef(null);  \n    \n    const rawData = [\n      [\n        'Project1',\n        'P1 description',\n        'HWSet1',\n        'Dataset1',\n      ],\n      [\n        'Project2',\n        'P2 description',\n        'HWSet2',\n        'Dataset2',\n      ],\n      [\n        'Project3',\n        'P3 description',\n        'HWSet3',\n        'Dataset3',\n      ],\n      [\n        'Project4',\n        'P4 description',\n        'HWSet4',\n        'Dataset4',\n      ],\n      [\n        'Project5',\n        'P5 description',\n        'HWSet5',\n        'Dataset5',\n      ]\n    ];\n\n    const columns = React.useMemo(\n      () => [\n        {\n          Header: 'Project Name',\n          accessor: 'col1', // accessor is the \"key\" in the data\n          filter:'pSearch'\n        },\n        {\n          Header: 'Project Description',\n          accessor: 'col2',\n        },\n        {\n          Header: 'Hardware Sets',\n          accessor: 'col3',\n        },\n        {\n          Header: 'Datasets',\n          accessor: 'col4',\n        },\n      ],[]\n    )\n  \n\n    function formatData(rawData){\n      const data = [];\n      for (let i = 0; i < rawData.length; i++){\n          data.push({\n            col1: rawData[i][0],\n            col2: rawData[i][1],\n            col3: rawData[i][2],\n            col4: rawData[i][3],\n          });\n      }\n      return data;\n    }\n\n\n    //If we want to edit projects\n    //On row click, hide table and display same structure as add project with filled in info\n    //On save changes click or x click hide add project structure and display table\n         \n     return (\n       <>\n        <div>\n         <div className='project-overview'>\n           <Table columns={columns} data={formatData(rawData)} ref={tableInstance} onClick={console.log('Hide Click')}/>\n         </div>\n         \n        \n            \n        </div>\n       </>\n     );\n }\n \n export default Project;","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Projectv2.js",["125"],"import React, { useImperativeHandle, useState, useRef } from \"react\";\nimport { useTable, useFilters, useGlobalFilter } from \"react-table\";\nimport '../styles/project.css'\nimport {Button} from '../components/button.style';\nimport EditProject from \"../components/editproject\";\nimport { useHistory } from 'react-router-dom';\n \nfunction Project2 (){\n  const tableInstance = useRef(null);  \n  const [rowInfo, setRowInfo] = useState({});\n  const [rowDisplay, setRowDisplay] = useState(false);\n  const history = useHistory();\n\n  const routeChange = () =>{ \n    let path = `addproject`; \n    history.push(path);\n  }\n    \n    const rawData = [\n      [\n        'Project1',\n        'P1 description',\n        'HWSet1',\n        'Dataset1',\n      ],\n      [\n        'Project2',\n        'P2 description',\n        'HWSet2',\n        'Dataset2',\n      ],\n      [\n        'Project3',\n        'P3 description',\n        'HWSet3',\n        'Dataset3',\n      ],\n      [\n        'Project4',\n        'P4 description',\n        'HWSet4',\n        'Dataset4',\n      ],\n      [\n        'Project5',\n        'P5 description',\n        'HWSet5',\n        'Dataset5',\n      ]\n    ];\n\n    const columns = React.useMemo(\n      () => [\n        {\n          Header: 'Project Name',\n          accessor: 'col1', // accessor is the \"key\" in the data\n          filter:'pSearch'\n        },\n        {\n          Header: 'Project Description',\n          accessor: 'col2',\n        },\n        {\n          Header: 'Hardware Sets',\n          accessor: 'col3',\n        },\n        {\n          Header: 'Datasets',\n          accessor: 'col4',\n        },\n      ],[]\n    )\n  \n\n    function formatData(rawData){\n      const data = [];\n      for (let i = 0; i < rawData.length; i++){\n          data.push({\n            col1: rawData[i][0],\n            col2: rawData[i][1],\n            col3: rawData[i][2],\n            col4: rawData[i][3],\n          });\n      }\n      return data;\n    }\n\n\n    //If we want to edit projects\n    //On row click, hide table and display same structure as add project with filled in info\n    //On save changes click or x click hide add project structure and display table\n\n    function rowClick(rowData){\n        setRowDisplay(true); \n        setRowInfo(rowData);\n    }\n         \n    const Table = React.forwardRef(({ columns, data }, ref) => {  \n        const instance = useTable(\n          {\n            columns,\n            data\n          },\n          useFilters, // useFilters!\n          useGlobalFilter // useGlobalFilter!\n        );\n      \n        const {\n          getTableProps,\n          getTableBodyProps,\n          headerGroups,\n          rows,\n          prepareRow,\n          state\n        } = instance;\n      \n        // return table instance\n        useImperativeHandle(ref, () => instance);\n      \n        const firstPageRows = rows.slice(0, 10);\n      \n          return (\n              <>\n              <table {...getTableProps()}>\n                  <thead>\n                  {headerGroups.map(headerGroup => (\n                      <tr {...headerGroup.getHeaderGroupProps()}>\n                      {headerGroup.headers.map(column => (\n                          <th {...column.getHeaderProps()}>{column.render(\"Header\")}</th>\n                      ))}\n                      </tr>\n                  ))}\n                  </thead>\n                  <tbody {...getTableBodyProps()}>\n                  {firstPageRows.map((row, i) => {\n                      prepareRow(row);\n                      return (\n                      <tr {...row.getRowProps()} onClick={rowClick(row.original)}>\n                          {row.cells.map(cell => {\n                          return (\n                              <td {...cell.getCellProps()}>{cell.render(\"Cell\")}</td>\n                          );\n                          })}\n                      </tr>\n                      );\n                  })}\n                  </tbody>\n              </table>\n              <br />\n              </>\n          );\n    });\n\n    if(rowDisplay){\n        console.log(rowDisplay);\n        return (\n            <div className='project-edit-container'>\n                <EditProject pName={rowInfo.col1} pDesc={rowInfo.col2} pHW={rowInfo.col3} pData={rowInfo.col4}/>\n                <Button onClick={() => {setRowDisplay(false);}}>Save Changes</Button>\n                <Button onClick={() => {setRowDisplay(false);}}>Discard Changes</Button>\n            </div>\n        );\n    }else{\n        return (\n       <>\n        <div>\n          <div className='header'>\n          <h1>Projects</h1>\n          <p>Click on a row to view/edit an existing project. </p>\n         </div>\n         \n         <div className='project-search'>\n          <input\n            onChange={(e) => {\n              tableInstance.current.setGlobalFilter(e.target.value);\n            }}\n            placeholder=\"Begin typing to search for a project by name\"\n          />\n        </div>\n\n         <div className='project-overview'>\n           <Table columns={columns} data={formatData(rawData)} ref={tableInstance} />\n         </div>\n         \n        <div className='project-add'>\n          <Button onClick={routeChange}>Add Project</Button>\n        </div>\n            \n        </div>\n       </>\n     );\n    }\n     \n }\n \n export default Project2;","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Datasets.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/navbar.js",["126","127"],"import React, { useState, useEffect } from 'react';\nimport { Link } from 'react-router-dom';\nimport '../styles/navbar.css'\nimport avacado from '../avacado_logo.png'\n\nfunction Navbar({ isAuth }) {\n  const [click, setClick] = useState(false);\n\n  const handleClick = () => setClick(!click);\n  const closeMobileMenu = () => setClick(false);\n\n  return (\n    <>\n      <nav className='navbar'>\n        <div className='navbar-container'>\n          <Link to='/' className='navbar-logo' onClick={closeMobileMenu}>\n            Avacad\n            <img className='navbar-avacado' src={avacado}/>\n          </Link>\n          <div className='menu-icon' onClick={handleClick}>\n            <i className={click ? 'fas fa-times' : 'fas fa-bars'} />\n          </div>\n          <ul className={click ? 'nav-menu active' : 'nav-menu'}>\n\n            <li className='nav-item'>\n              <Link to='/' className='nav-links' onClick={closeMobileMenu}>\n                Home\n              </Link>\n            </li>\n\n            <li className='nav-item'>\n              <Link\n                to='/dashboard'\n                className='nav-links'\n                onClick={closeMobileMenu}\n              >\n                Dashboard\n              </Link>\n            </li>\n    \n            <li className='nav-item'>\n              <Link\n                to='/projects'\n                className='nav-links'\n                onClick={closeMobileMenu}\n              >\n                Projects\n              </Link>\n            </li>\n\n            <li className='nav-item'>\n              <Link\n                to='/datasets'\n                className='nav-links'\n                onClick={closeMobileMenu}\n              >\n                Datasets\n              </Link>\n            </li>\n\n            {\n              isAuth ?\n              <li className='nav-item'>\n                <Link\n                  to='/logout'\n                  className='nav-links'\n                  onClick={closeMobileMenu}\n                >\n                  Logout\n                </Link>\n              </li>\n              : <li className='nav-item'>\n                <Link\n                  to='/login'\n                  className='nav-links'\n                  onClick={closeMobileMenu}\n                >\n                  Login\n                </Link>\n              </li>\n            }\n          </ul>\n        </div>\n      </nav>\n    </>\n  );\n}\n\nexport default Navbar;","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/AddProject.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/pages/Dashboard.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/table.js",["128"],"import React, { useImperativeHandle, useState } from \"react\";\nimport { useTable, useFilters, useGlobalFilter } from \"react-table\";\nimport '../styles/table.css'\nimport EditProject from \"./editproject\";\nimport {Button} from './button.style'\nimport '../styles/project.css'\nimport { useHistory } from 'react-router-dom';\n\n// Our table component\nconst Table = React.forwardRef(({ columns, data }, ref) => {  \n  const [rowInfo, setRowInfo] = useState({});\n  const [rowDisplay, setRowDisplay] = useState(false);\n\n  const history = useHistory();\n\n  const routeChange = () =>{ \n    let path = `addproject`; \n    history.push(path);\n  }\n\n\n  const instance = useTable(\n    {\n      columns,\n      data\n    },\n    useFilters, // useFilters!\n    useGlobalFilter // useGlobalFilter!\n  );\n\n  const {\n    getTableProps,\n    getTableBodyProps,\n    headerGroups,\n    rows,\n    prepareRow,\n    state\n  } = instance;\n\n  // return table instance\n  useImperativeHandle(ref, () => instance);\n\n  const firstPageRows = rows.slice(0, 10);\n\n  if(rowDisplay){\n    return (\n        <>\n            <div className='Test'>\n                <div className='header'>\n                    <h2>Edit {rowInfo.col1}</h2>\n                </div>\n                <div className='project-edit-container'>\n                    <EditProject pName={rowInfo.col1} pDesc={rowInfo.col2} pHW={rowInfo.col3} pData={rowInfo.col4}/>\n                    <Button onClick={() => {setRowDisplay(false);}}>Save Changes</Button>\n                    <Button onClick={() => {setRowDisplay(false);}}>Discard Changes</Button>\n                </div>\n            </div>\n        </>\n    );\n  }else{\n    return (\n        <>\n        <div>\n            <div className='header'>\n                <h1>Projects</h1>\n                <p>Click on a row to view/edit an existing project. </p>\n            </div>\n\n            <div className='project-search'>\n                <input\n                    onChange={(e) => {\n                    instance.setGlobalFilter(e.target.value);\n                    }}\n                    placeholder=\"Begin typing to search for a project by name\"\n                />\n            </div>\n\n            <table {...getTableProps()}>\n                <thead>\n                {headerGroups.map(headerGroup => (\n                    <tr {...headerGroup.getHeaderGroupProps()}>\n                    {headerGroup.headers.map(column => (\n                        <th {...column.getHeaderProps()}>{column.render(\"Header\")}</th>\n                    ))}\n                    </tr>\n                ))}\n                </thead>\n                <tbody {...getTableBodyProps()}>\n                {firstPageRows.map((row, i) => {\n                    prepareRow(row);\n                    return (\n                    <tr {...row.getRowProps()} onClick={() => {setRowDisplay(true); setRowInfo(row.original);}}>\n                        {row.cells.map(cell => {\n                        return (\n                            <td {...cell.getCellProps()}>{cell.render(\"Cell\")}</td>\n                        );\n                        })}\n                    </tr>\n                    );\n                })}\n                </tbody>\n            </table>\n\n            <div className='project-add'>\n            <Button onClick={routeChange}>Add Project</Button>\n            </div>\n        </div>\n        \n        </>\n    );\n  }\n});\n\nexport default Table;","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/editproject.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/button.style.js",["129"],"import styled from 'styled-components';\n\nimport React from 'react'\n\nexport const Button = styled.button`\n  border-radius: 4px;\n  background: ${(props) => props.backgroundColor};\n  white-space: nowrap;\n  padding: ${(props) => (props.big ? \"12px 64px\" : \"10px 20px\")};\n  color: #fff;\n  font-size: ${(props) => (props.fontBig ? \"20px\" : \"16px\")};\n  outline: none;\n  border: none;\n  cursor: pointer;\n\n  &:hover {\n    transition: all 0.3s ease-out;\n    background: #fff;\n    background: ${(props) => props.hoverColor};\n  }\n\n  @media screen and (max-width: 960px) {\n    width: 100%;\n  }\n\n`;\n\nButton.defaultProps = {\n  backgroundColor: \"#2eb62c\",\n  hoverColor: \"#abe098\"\n};","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/datasetTable.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/projectoverview.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/ContentContainer.style.js",["130"],"import React from 'react'\nimport styled from 'styled-components';\n\nexport const ContentContainer = styled.div`\n  display: flex;\n  margin: ${(props) => props.margin};\n  padding: ${(props) => props.padding};\n  width: ${(props) => props.width};\n  border: ${(props) => (props.border ? \"5px solid #FFECA1\" : \"0\")};\n  justify-content: ${(props) => (props.center? \"center\": \"0\")};\n  align-items: ${(props) => (props.center? \"center\": \"0\")};\n  max-height: ${(props) => props.maxheight};\n  max-width: ${(props) => props.maxwidth};\n  flex-direction: ${(props) => props.flexdirection};\n`;\n\n\nexport default ContentContainer\n","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/DashboardRow.style.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/projectquickadd/projectquickadd.js",["131"],"import React from \"react\";\nimport { TextField } from \"@mui/material\";\nimport { withStyles } from \"@mui/styles\";\nimport { Button } from \"../../button.style\";\nimport {\n  QuickAddContainer,\n  Title,\n  TextFieldWrapper,\n  FieldDesc,\n} from \"./projectquickadd.style\";\n\nconst ProjectQuickAdd = () => {\n  return (\n    <>\n      <QuickAddContainer>\n        <Title>Project Quick Add</Title>\n        <FieldDesc>Project Name:</FieldDesc>\n        <TextFieldWrapper>\n          <TextField variant=\"outlined\" color=\"primary\" label=\"Project Name\" focused />\n        </TextFieldWrapper>\n        <FieldDesc>Project Description:</FieldDesc>\n        <TextFieldWrapper>\n          <TextField variant=\"outlined\" color=\"primary\" focused multiline label=\"Project Description\" rows=\"6\" maxrows=\"6\" />\n        </TextFieldWrapper>\n        <Button>+ Project</Button>\n      </QuickAddContainer>\n    </>\n  );\n}\n\nexport default ProjectQuickAdd;\n","/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/projectquickadd/projectquickadd.style.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/projectlookup/projectlookup.js",[],"/Users/sampippen/Documents/GitHub/EE461L_Final_Project/haas-avocados/src/components/dashboardcomponents/projectlookup/projectlookup.style.js",[],{"ruleId":"132","replacedBy":"133"},{"ruleId":"134","replacedBy":"135"},{"ruleId":"136","severity":1,"message":"137","line":2,"column":35,"nodeType":"138","messageId":"139","endLine":2,"endColumn":39},{"ruleId":"136","severity":1,"message":"140","line":8,"column":8,"nodeType":"138","messageId":"139","endLine":8,"endColumn":16},{"ruleId":"136","severity":1,"message":"141","line":11,"column":8,"nodeType":"138","messageId":"139","endLine":11,"endColumn":14},{"ruleId":"136","severity":1,"message":"142","line":7,"column":10,"nodeType":"138","messageId":"139","endLine":7,"endColumn":18},{"ruleId":"136","severity":1,"message":"143","line":8,"column":27,"nodeType":"138","messageId":"139","endLine":8,"endColumn":33},{"ruleId":"136","severity":1,"message":"144","line":8,"column":35,"nodeType":"138","messageId":"139","endLine":8,"endColumn":41},{"ruleId":"136","severity":1,"message":"145","line":8,"column":43,"nodeType":"138","messageId":"139","endLine":8,"endColumn":48},{"ruleId":"136","severity":1,"message":"146","line":10,"column":9,"nodeType":"138","messageId":"139","endLine":10,"endColumn":19},{"ruleId":"136","severity":1,"message":"143","line":7,"column":26,"nodeType":"138","messageId":"139","endLine":7,"endColumn":32},{"ruleId":"136","severity":1,"message":"144","line":7,"column":34,"nodeType":"138","messageId":"139","endLine":7,"endColumn":40},{"ruleId":"136","severity":1,"message":"145","line":7,"column":42,"nodeType":"138","messageId":"139","endLine":7,"endColumn":47},{"ruleId":"136","severity":1,"message":"147","line":3,"column":8,"nodeType":"138","messageId":"139","endLine":3,"endColumn":12},{"ruleId":"136","severity":1,"message":"141","line":9,"column":9,"nodeType":"138","messageId":"139","endLine":9,"endColumn":15},{"ruleId":"136","severity":1,"message":"148","line":10,"column":10,"nodeType":"138","messageId":"139","endLine":10,"endColumn":20},{"ruleId":"136","severity":1,"message":"149","line":114,"column":11,"nodeType":"138","messageId":"139","endLine":114,"endColumn":16},{"ruleId":"136","severity":1,"message":"150","line":1,"column":27,"nodeType":"138","messageId":"139","endLine":1,"endColumn":36},{"ruleId":"151","severity":1,"message":"152","line":18,"column":13,"nodeType":"153","endLine":18,"endColumn":60},{"ruleId":"136","severity":1,"message":"149","line":37,"column":5,"nodeType":"138","messageId":"139","endLine":37,"endColumn":10},{"ruleId":"136","severity":1,"message":"154","line":3,"column":8,"nodeType":"138","messageId":"139","endLine":3,"endColumn":13},{"ruleId":"136","severity":1,"message":"154","line":1,"column":8,"nodeType":"138","messageId":"139","endLine":1,"endColumn":13},{"ruleId":"136","severity":1,"message":"155","line":3,"column":10,"nodeType":"138","messageId":"139","endLine":3,"endColumn":20},"no-native-reassign",["156"],"no-negated-in-lhs",["157"],"no-unused-vars","'Link' is defined but never used.","Identifier","unusedVar","'Project2' is defined but never used.","'Button' is defined but never used.","'useState' is defined but never used.","'Router' is defined but never used.","'Switch' is defined but never used.","'Route' is defined but never used.","'Typography' is defined but never used.","'Auth' is defined but never used.","'useHistory' is defined but never used.","'state' is assigned a value but never used.","'useEffect' is defined but never used.","jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","'React' is defined but never used.","'withStyles' is defined but never used.","no-global-assign","no-unsafe-negation"]
